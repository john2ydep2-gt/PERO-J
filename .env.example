# Soroban RPC endpoint (testnet default)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Horizon API (for classic asset data)
HORIZON_URL=https://horizon-testnet.stellar.org

# Network passphrase
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Comma-separated SAC assets: [{"code":"USDC","issuer":"GA..."}]
SAC_ASSETS=[]

# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/soroban_explorer

# Indexer settings
START_LEDGER=0
POLL_MS=5000

# API server port
PORT=3001

# Deployed explorer contract ID (set after `make deploy`)
EXPLORER_CONTRACT_ID=

# Admin API key for DELETE /api/contracts/:id (set to a strong random value in production)
API_ADMIN_KEY=

# Frontend: API base URL (Vite env variable, must be prefixed with VITE_)
# In development the frontend proxies /api via Vite, so this can be left blank.
# In production set this to the full API origin, e.g.:
#   VITE_API_URL=https://api.pero-j.io/api
VITE_API_URL=

# Frontend version traceability (displayed in the footer)
# Set VITE_COMMIT_SHA at build time (e.g. CI) to the git commit SHA.
# Falls back to "local" and "dev" respectively when unset.
#   VITE_COMMIT_SHA=abc1234def567890
#   VITE_APP_VERSION=1.2.3
VITE_COMMIT_SHA=
VITE_APP_VERSION=

# ── Backup (scripts/backup.sh) ────────────────────────────────────────────────
# BACKUP_DIR=./backups
# RETENTION_DAYS=7
